# Rule-based customer service chatbot (TechSupportBot)

def main():
    print("=========================================")
    print("Welcome to TechSupport Bot! (Type 'exit' to quit)")
    print("=========================================")
    print("Bot: Hello! How can I help you with your purchase today?")

    while True:
        user_input = input("\nYou: ")

        # Clean the input (lowercase for easier matching)
        clean_input = user_input.lower()

        # Exit condition
        if clean_input in ("exit", "quit"):
            print("Bot: Thank you for visiting! Have a great day!")
            break

        # Rule-based routing
        if "price" in clean_input or "cost" in clean_input:
            print("Bot: Our laptops start at $499 and smartphones start at $299."
                  " Do you want pricing on a specific model?")

        elif "shipping" in clean_input or "delivery" in clean_input:
            print("Bot: Standard shipping takes 3-5 business days."
                  " Orders over $50 ship free!")

        elif "return" in clean_input or "refund" in clean_input:
            print("Bot: We offer a 30-day money-back guarantee."
                  " Just keep your receipt and original packaging.")

        elif "hello" in clean_input or "hi" in clean_input:
            print("Bot: Hi there! How can I assist you today?")

        else:
            print("Bot: I'm sorry, I didn't quite understand that."
                  " Could you try asking about 'pricing', 'shipping', or 'returns'?")


if __name__ == "__main__":
    main()

