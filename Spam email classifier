# Spam email filter using keyword scoring

# List of high-trigger spam keywords
SPAM_KEYWORDS = [
    "free", "winner", "lottery", "urgent", "cash",
    "click here", "subscribe", "credit card", "risk-free",
]


def main():
    print("=========================================")
    print("        Spam Email Filter Tool")
    print("=========================================")

    email_content = input("Paste or type your email text below:\n> ")

    clean_email = email_content.lower()
    spam_score = 0
    found_keywords = []

    # Check how many spam keywords are in the text
    for keyword in SPAM_KEYWORDS:
        pos = clean_email.find(keyword)

        while pos != -1:
            spam_score += 1

            # Save keyword to show the user later (once per keyword type)
            if keyword not in found_keywords:
                found_keywords.append(keyword)

            # Move past the current match to check if it appears again
            pos = clean_email.find(keyword, pos + len(keyword))

    # Output analysis results
    print("\n--- Analysis Results ---")
    print("Spam Trigger Score:", spam_score)

    # Threshold: if 2 or more spam words are found, flag it
    if spam_score >= 2:
        print("Status: [SPAM DETECTED]")
        print("Triggers found:", "".join(f"'{w}'" for w in found_keywords))
        print("Action: Sent to the Junk folder.")
    else:
        print("Status: [HAM/CLEAN EMAIL]")
        print("Action: Delivered safely to the Inbox.")


if __name__ == "__main__":
    main()
